# ─── LLM Provider (set ONE of these API keys) ────────────────────────────────
# Auto-detected in this priority order: Anthropic → OpenAI → Gemini → xAI → Groq
# You can also force a provider with: LLM_PROVIDER=groq|anthropic|openai|gemini|xai

# Groq — FREE tier, fastest, great for demos  https://console.groq.com
GROQ_API_KEY=gsk_...

# Anthropic Claude — best code quality        https://console.anthropic.com
# ANTHROPIC_API_KEY=sk-ant-...

# OpenAI — GPT-4o / GPT-4o-mini               https://platform.openai.com
# OPENAI_API_KEY=sk-...

# Google Gemini                                https://aistudio.google.com
# GEMINI_API_KEY=AIza...

# xAI Grok                                     https://console.x.ai
# XAI_API_KEY=xai-...

# ─── Optional model overrides ─────────────────────────────────────────────────
# Defaults are chosen per provider (e.g. claude-sonnet-4-6 for Anthropic agents)
# AGENT_MODEL=gpt-4o
# JUDGE_MODEL=gpt-4o-mini

# ─── MPP / Tempo ─────────────────────────────────────────────────────────────
# Set to "true" to skip real on-chain payments (great for local dev/demos)
MPP_DEMO_MODE=true

# MPP server secret — generate with: openssl rand -hex 32
MPP_SECRET_KEY=your_mpp_secret_key_here

# Tempo stablecoin contract address (testnet)
TEMPO_CURRENCY_ADDRESS=0x20c0000000000000000000000000000000000000

# Your wallet that receives submission fees
RECIPIENT_ADDRESS=0x742d35Cc6634c0532925a3b844bC9e7595F8fE00

# Agent wallet private keys (for auto-paying submission fees in non-demo mode)
AGENT_ALPHA_PRIVATE_KEY=0x...
AGENT_BETA_PRIVATE_KEY=0x...
AGENT_GAMMA_PRIVATE_KEY=0x...

# ─── App ─────────────────────────────────────────────────────────────────────
# Set to your public URL when using external agent webhooks with ngrok
NEXT_PUBLIC_APP_URL=http://localhost:3000
